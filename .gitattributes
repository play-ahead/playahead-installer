# ============================================================
# Fim de linha
#
# O produto deste repositório é um script bash que roda em
# Ubuntu. Um CRLF que escape para dentro do dist/mautic7.sh faz
# a VPS responder "bash: \r: command not found" — erro que não
# diz nada sobre a causa e some quando você olha o arquivo no
# editor do Windows.
#
# Sem estas regras, o core.autocrlf=true de uma máquina Windows
# entrega working copies com CRLF, e um build feito a partir
# delas nasce quebrado.
# ============================================================

# Padrão: git decide o que é texto, mas texto é sempre LF.
* text=auto eol=lf

# Explícitos, para não depender da heurística de detecção.
*.sh    text eol=lf
*.bash  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.env   text eol=lf
LICENSE text eol=lf

.gitattributes text eol=lf
.gitignore     text eol=lf

# O artefato publicado. É o que o curl entrega direto para o
# bash de uma VPS, então é onde o CRLF custaria mais caro.
dist/**  text eol=lf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.ico binary
*.gz  binary
*.zip binary
